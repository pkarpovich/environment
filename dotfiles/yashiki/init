#!/opt/homebrew/bin/fish

function tag
    math "2^($argv[1] - 1)"
end

# Monitors (by name - stable across reconnect)
set -l LAPTOP "Built-in"
set -l DELL_LANDSCAPE "U2723QE"
set -l DELL_PORTRAIT "U2720Q"

# --- Single-screen (MacBook Air) adaptation --------------------------------
# The desktop separates apps by monitor. On one screen only a single tag is
# visible at a time, so instead of piling every monitor's apps onto shared tags
# we give each monitor its own tag bank - every slot keeps a dedicated tag,
# reached via the tuna exec-or-focus (focus-by-app) bindings:
#   laptop apps -> tags 1-10 (unchanged) | landscape -> +10 | portrait -> +20
set -g DL_OFFSET 0
set -g DP_OFFSET 0
set -g SINGLE_SCREEN 0
if test (yashiki list-outputs | grep -E '^[0-9]+:' | grep -vc "Built-in") -eq 0
    set DELL_LANDSCAPE "Built-in"
    set DELL_PORTRAIT "Built-in"
    set -g DL_OFFSET 10
    set -g DP_OFFSET 20
    set -g SINGLE_SCREEN 1
end

function dltag # landscape-bank tag
    tag (math "$argv[1] + $DL_OFFSET")
end

function dptag # portrait-bank tag
    tag (math "$argv[1] + $DP_OFFSET")
end

yashiki add-exec-path /opt/homebrew/bin

yashiki layout-set-default tatami
yashiki set-outer-gap 8
yashiki layout-cmd --layout tatami set-inner-gap 8
yashiki layout-cmd --layout tatami set-main-ratio 0.6
yashiki layout-cmd --layout kakejiku set-inner-gap 8

# Portrait monitor: start tag 5 in the kakejiku (vertical) layout (desktop only)
if test "$SINGLE_SCREEN" != 1
    yashiki layout-set kakejiku --tags (tag 5) --output "$DELL_PORTRAIT"
end

# Cursor follows focus - warps to the newly focused window (any monitor)
yashiki set-cursor-warp on-focus-change

for i in (seq 1 9)
    yashiki bind "alt-$i" tag-view (tag $i)
    yashiki bind "alt-shift-$i" window-move-to-tag (tag $i)
    yashiki bind "alt-ctrl-$i" window-toggle-tag (tag $i)
end

# Presentation tag (10) - on the 0 key (10th digit); staging canvas on the shared DELL for screen-share
yashiki bind alt-0 tag-view (tag 10)
yashiki bind alt-shift-0 window-move-to-tag (tag 10)
yashiki bind alt-ctrl-0 window-toggle-tag (tag 10)

yashiki bind alt-h window-focus left
yashiki bind alt-j window-focus down
yashiki bind alt-k window-focus up
yashiki bind alt-l window-focus right

# Multi-monitor (desktop only - no-op on a single screen)
if test "$SINGLE_SCREEN" != 1
    yashiki bind alt-n output-focus next
    yashiki bind alt-p output-focus prev
    yashiki bind alt-shift-n output-send next
    yashiki bind alt-shift-p output-send prev
end

yashiki bind alt-t layout-set tatami     # tile (master-stack)
yashiki bind alt-b layout-set byobu      # accordion
yashiki bind alt-v layout-set kakejiku   # vertical rows for portrait (1/3 stack top, 2/3 main bottom)

# Window management
yashiki bind alt-f window-toggle-fullscreen
yashiki bind alt-shift-f window-toggle-float
yashiki bind alt-shift-c window-close
yashiki bind alt-return retile
yashiki bind alt-shift-r tag-toggle 0   # hard retile: resync (drop ghost windows) + retile focused output
yashiki bind alt-m layout-cmd zoom   # promote focused window to master slot

# Ignore transient popups (prevents flicker / focus ping-pong)
yashiki rule-add --subrole AXUnknown ignore
yashiki rule-add --close-button none ignore

yashiki rule-add --app-id company.thebrowser.dia tags (tag 1)
yashiki rule-add --app-id company.thebrowser.dia output "$LAPTOP"

yashiki rule-add --app-id dev.zed.Zed tags (dltag 4)
yashiki rule-add --app-id dev.zed.Zed output "$DELL_LANDSCAPE"
yashiki rule-add --app-id dev.zed.Zed --title "*dealcloud*" tags (dltag 1)
yashiki rule-add --app-id dev.zed.Zed --title "*dealcloud*" output "$DELL_LANDSCAPE"
yashiki rule-add --app-id dev.zed.Zed --title "*environment*" tags (dltag 2)
yashiki rule-add --app-id dev.zed.Zed --title "*environment*" output "$DELL_LANDSCAPE"
yashiki rule-add --app-id dev.zed.Zed --title "*turtle-hub*" tags (dltag 3)
yashiki rule-add --app-id dev.zed.Zed --title "*turtle-hub*" output "$DELL_LANDSCAPE"

yashiki rule-add --app-id com.sublimemerge tags (dltag 5)
yashiki rule-add --app-id com.sublimemerge output "$DELL_LANDSCAPE"

yashiki rule-add --app-id com.github.wez.wezterm tags (dptag 5)
yashiki rule-add --app-id com.github.wez.wezterm output "$DELL_PORTRAIT"
yashiki rule-add --app-id com.umputun.agterm tags (dptag 4)
yashiki rule-add --app-id com.umputun.agterm output "$DELL_PORTRAIT"

yashiki rule-add --app-id com.tinyspeck.slackmacgap tags (tag 6)
yashiki rule-add --app-id com.tinyspeck.slackmacgap output "$LAPTOP"
yashiki rule-add --app-id ru.keepcoder.Telegram tags (tag 5)
yashiki rule-add --app-id ru.keepcoder.Telegram output "$LAPTOP"
yashiki rule-add --app-id com.microsoft.teams2 tags (tag 8)
yashiki rule-add --app-id com.microsoft.teams2 output "$LAPTOP"
yashiki rule-add --app-id net.whatsapp.WhatsApp tags (tag 9)
yashiki rule-add --app-id net.whatsapp.WhatsApp output "$LAPTOP"
yashiki rule-add --app-id com.apple.mail tags (tag 3)
yashiki rule-add --app-id com.apple.mail output "$LAPTOP"
yashiki rule-add --app-id com.apple.iCal tags (tag 4)
yashiki rule-add --app-id com.apple.iCal output "$LAPTOP"

yashiki rule-add --app-id md.obsidian tags (tag 7)
yashiki rule-add --app-id md.obsidian output "$LAPTOP"

yashiki rule-add --app-id com.usebruno.app tags (tag 2)
yashiki rule-add --app-id com.usebruno.app output "$LAPTOP"
yashiki rule-add --app-id com.parallels.desktop.console tags (dltag 6)
yashiki rule-add --app-id com.parallels.desktop.console output "$DELL_LANDSCAPE"
yashiki rule-add --app-id com.spotify.client tags (dptag 8)
yashiki rule-add --app-id com.spotify.client output "$DELL_PORTRAIT"
yashiki rule-add --app-id com.apple.iphonesimulator tags (dltag 2)
yashiki rule-add --app-id com.apple.iphonesimulator output "$DELL_LANDSCAPE"
yashiki rule-add --app-id com.apple.iphonesimulator float
yashiki rule-add --app-id com.colliderli.iina tags (dptag 5)
yashiki rule-add --app-id com.colliderli.iina output "$DELL_PORTRAIT"

yashiki rule-add --app-id com.brnbw.Tuna float
yashiki rule-add --app-name Finder float
yashiki rule-add --app-name "System Settings" float
yashiki rule-add --app-name "System Preferences" float
yashiki rule-add --subrole Dialog float
yashiki rule-add --subrole FloatingWindow float
yashiki rule-add --fullscreen-button none float

# Active-window border (JankyBorders) - tracked, dies with yashiki
yashiki exec --track "borders active_color='glow(0xffc4a7e7)' inactive_color=0x00000000 width=5.0 hidpi=on"

# Status bar (ranma) - tracked, so it dies with yashiki and relaunches on restart
yashiki exec --track "ranma start --init $HOME/.config/yashiki/ranma/init"