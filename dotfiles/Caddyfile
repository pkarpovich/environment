# every *.localhost name is one site. Its port comes from two tables of
# "<domain> <port>" lines: caddy/routes/*.map in the repo, written by hand, and the
# table foster's hook writes from the running sessions. run_onchange_after_51 links
# both next to this file, since import paths resolve from /opt/homebrew/etc, not
# from the repo. The per-machine snippet caddy-site.caddy decides what happens to
# a name no table knows
import caddy-site.caddy

(proxy) {
    map {host} {upstream_port} {
        import caddy-routes/*.map
        import foster-routes/*.map
        default ""
    }
    @known expression `{upstream_port} != ""`
    handle @known {
        # flush_interval -1 streams SSE and long polls as they are written;
        # X-Served-By names the machine that answered
        reverse_proxy localhost:{upstream_port} {
            flush_interval -1
            header_down X-Served-By {system.hostname}
        }
    }
    handle {
        import unknown
    }
    import errors
}

# a browser rejects a certificate for *.*.localhost, so every name gets its own
# from the local CA on its first request
*.localhost, *.*.localhost {
    tls internal {
        on_demand
    }
    import proxy
}
