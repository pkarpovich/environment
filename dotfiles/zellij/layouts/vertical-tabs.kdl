layout {
    new_tab_template {
        pane split_direction="vertical" {
            pane size=26 borderless=true {
                plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm"
            }
            pane
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab {
        pane split_direction="vertical" {
            pane size=26 borderless=true {
                plugin location="file:~/.config/zellij/plugins/zellij-vertical-tabs.wasm"
            }
            pane
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
}
