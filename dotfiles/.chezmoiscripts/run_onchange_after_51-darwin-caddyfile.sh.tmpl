{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# caddy reads its config from the Homebrew prefix, outside the home directory
# chezmoi manages. The Caddyfile imports caddy-site.caddy from there: this host's
# snippet when caddy/ has one, the default otherwise
set -eu
etc=/opt/homebrew/etc
caddy_src={{ joinPath .chezmoi.sourceDir "caddy" | quote }}
site="$caddy_src/$(scutil --get LocalHostName).caddy"
[ -f "$site" ] || site="$caddy_src/default.caddy"
ln -sfn {{ joinPath .chezmoi.sourceDir "Caddyfile" | quote }} "$etc/Caddyfile"
ln -sfn "$site" "$etc/caddy-site.caddy"
# the running caddy keeps the config it started with until told otherwise
if pgrep -qx caddy; then
    caddy reload --config "$etc/Caddyfile"
fi
{{ end -}}
