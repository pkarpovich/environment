# vim: ft=ruby
#
# Linked to ~/.Brewfile, so `brew bundle` works from any directory. Grouped by what a
# thing is FOR, not by when it was added - a package nobody can place in a group here
# is usually a package nobody needs.

tap("pkarpovich/apps", trusted: true)

### shell, prompt, and what loads on every command

brew("fish")
# the brew git is what actually runs (/opt/homebrew/bin/git), not Apple's
brew("git")
brew("mise")
brew("starship")
brew("atuin")

### the coreutils the shell actually reaches for

brew("eza")
brew("bat")
brew("fd")
brew("ripgrep")
brew("fzf")
brew("sk")
brew("zoxide")
brew("jq")
brew("broot")
# moor is aliased to cat in config.fish
brew("moor")

### terminals, multiplexers, and the phone link

cask("umputun/apps/agterm", trusted: true)
# still the terminal on the MBA; agterm took over on this machine, but the
# wezterm/ config is linked on both
cask("wezterm@nightly")
# tmux: the mux ccm mirrors agterm's Claude sessions into, and the only one
# Moshi's chat can read (preview, agent status, session tree are tmux-only)
brew("tmux")
# mosh: the phone (Moshi) attaches to the tmux sessions over it - the link
# survives sleep, network switches and app kills, unlike plain ssh
brew("mosh")
brew("zellij")

### yazi and the previewers it shells out to

brew("yazi")
brew("ffmpeg")
brew("poppler")
brew("imagemagick")
brew("sevenzip")

