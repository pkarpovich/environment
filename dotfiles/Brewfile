cask("umputun/apps/revmux", trusted: true)
brew("melonamin/formulae/gt", trusted: true)
brew("jnsahaj/lumen/lumen", trusted: true)
brew("commit-author-refresher")
cask("codex")
brew("umputun/apps/ralphex", trusted: true)
brew("umputun/apps/fya", trusted: true)
brew("agent-browser")
# moshi-hook bridges the coding agents to the Moshi daemon
brew("rjyo/moshi/moshi-hook", trusted: true)

### containers: colima VM instead of Docker Desktop; autostart via
### colima/com.pavel-karpovich.colima.plist (NOT brew services - its
### `colima start -f` resets colima.yaml to defaults on every start)

brew("colima")
brew("docker")
brew("docker-compose")
# osxkeychain credsStore for docker login, Docker Desktop's helper is gone
brew("docker-credential-helper")

### network, and the tools for when it misbehaves

brew("curlie")
brew("gping")
brew("doggo")
# mtr shows per-hop loss live, which is how the nhop NAT drops got found
brew("mtr")
brew("wget")
brew("nhop")
# runs under brew services, so an upgrade has to restart it - otherwise the old
# binary keeps serving until someone notices
brew("caddy", restart_service: :changed)
# the Standalone variant (system extension), never the App Store one: the two
# cannot coexist and Tailscale itself recommends Standalone. Sparkle updates it.
cask("tailscale-app")

