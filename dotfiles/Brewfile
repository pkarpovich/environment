### my own tools

brew("turtle-harbor")
brew("shortcuts-remote-server")
brew("ovq")
brew("bruq")
brew("ralphex-macos-runner")
# casks, not formulae, and not under brew services: macOS ties the permissions
# each daemon needs - Accessibility for nikki, the microphone for mimi - to the
# app's bundle id at a fixed path, while a formula moves the binary into a
# versioned Cellar path on every upgrade and the grant is lost with it. Both
# install their own launchd agent: `nikki install`, `mimi install`, once.
cask("pkarpovich/apps/nikki", trusted: true)
cask("pkarpovich/apps/mimi", trusted: true)

### media, backup, work

brew("mpv")
brew("restic")
brew("azure-cli")

### fonts. Every one but the last is referenced by a config: Iosevka Term is the
### terminal face in agterm/ghostty-settings.conf, wezterm.lua and corne's --mono;
### Maple Mono NF is Zed's buffer and UI face; Hack Nerd Font is ranma's menu bar;
### symbols-only is wezterm's icon fallback. Nothing else earns a permanent install
### on that rule alone

cask("font-iosevka")
cask("font-maple-mono-nf")
cask("font-hack-nerd-font")
cask("font-symbols-only-nerd-font")

### Roboto is the exception: no config here names it, it is here so somebody else's
### HTML renders. Marketing and transactional mail templates open their font stacks
### with Roboto, macOS ships no such face, and the usual second name in those stacks
### is Helvetica - which carries no Latin Extended-A, so Polish and Czech diacritics
### have nowhere to land and whole paragraphs come out as tofu in Mail. Removing it
### costs nothing visible until a receipt arrives unreadable weeks later
cask("font-roboto")

### Mac App Store. brew bundle installs these by id, the name is only a label.
### Keynote and Numbers appear twice on purpose: the 36xxxxxxx ids are the iPad
### builds that Apple Silicon can run, the 40xxxxxxx ones are the mac apps

