[
  {
    "context": "Editor",
    "bindings": {
      "cmd-e": "tab_switcher::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-t": "task::Spawn",
      "cmd-shift-r": "task::Rerun",
      "cmd-\\": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "(Editor && mode == full)",
    "bindings": {
      "cmd-\\": null
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-\\": null
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-b": null
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "cmd--": [
        "action::Sequence",
        [
          "project_panel::CollapseAllEntries",
          "menu::SelectFirst"
        ]
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd--": [
        "action::Sequence",
        [
          "project_panel::ToggleFocus",
          "project_panel::CollapseAllEntries",
          "menu::SelectFirst"
        ]
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd--": [
        "action::Sequence",
        [
          "project_panel::ToggleFocus",
          "project_panel::CollapseAllEntries",
          "menu::SelectFirst"
        ]
      ]
    }
  }
]
